<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds speak HTTPS only. Debug builds override this in src/debug to reach a local server. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
